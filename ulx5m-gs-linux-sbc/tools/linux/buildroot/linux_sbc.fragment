# ULX5M-GS SBC (TASK-5051): additions to linux-on-litex-vexriscv board/litex_vexriscv/linux.config (Linux 6.12).
# DVI console (simplefb + fbcon) with small fonts (lesson K19: the prebuilt 5.14 has only VGA8x8/VGA8x16)
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x8=y
CONFIG_FONT_8x16=y
CONFIG_FONT_6x8=y
CONFIG_FONT_6x10=y
CONFIG_FONT_MINI_4x6=y
# CONFIG_LOGO is not set
# Keyboard/mouse from the userspace USB host (tools/usbhostd) as real input devices
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
# ip= on the kernel command line (RESEARCH_LINUX_GATEMATE: 5.14 has no IP_PNP)
CONFIG_IP_PNP=y
# usbhostd maps the usb_pnru CSRs through /dev/mem
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set
# SPI-SD (target_soc.py --sdcard spi): LiteSPI + mmc_spi
CONFIG_SPI=y
CONFIG_SPI_LITESPI=y
CONFIG_MMC=y
CONFIG_MMC_SPI=y
