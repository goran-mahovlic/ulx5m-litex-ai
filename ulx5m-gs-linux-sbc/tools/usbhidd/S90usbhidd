#!/bin/sh
# TASK-5047: USB keyboard (usb_hid CSRs, gateware/usb_hid.py) -> /dev/tty1, and a login shell on the DVI console.
# usbhidd runs only if the device tree has the usbhid@<csr> node (tools/linux/mkdts.py): the CSR address differs per build.
case "$1" in
  start|"")
    for n in /proc/device-tree/usbhid@*; do
      [ -e "$n" ] && [ -x /usr/bin/usbhidd ] && /usr/bin/usbhidd 0x${n##*@} > /var/log/usbhidd.log 2>&1 &
    done
    [ -e /dev/tty1 ] && (while true; do /sbin/getty 38400 tty1; sleep 1; done) > /dev/null 2>&1 &
    ;;
  stop)
    killall usbhidd getty 2>/dev/null
    ;;
esac
exit 0
