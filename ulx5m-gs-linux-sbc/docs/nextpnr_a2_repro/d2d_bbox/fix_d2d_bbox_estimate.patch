+// Extra horizontal distance of a die crossing when both ends lie left of the first column with die-to-die
+// connections (the route has to go there and back).
+static int d2d_detour(int d2d_x0, int sx, int dx) { return 2 * std::max(0, d2d_x0 - std::max(sx, dx)); }
+
 delay_t GateMateImpl::estimateDelay(WireId src, WireId dst) const
 {
     int sx, sy, dx, dy;
     int d2d = 0;
-    if (tile_extra_data(src.tile)->die != tile_extra_data(dst.tile)->die)
-        d2d += 2000;
     tile_xy(ctx->chip_info, src.tile, sx, sy);
     tile_xy(ctx->chip_info, dst.tile, dx, dy);
+    if (tile_extra_data(src.tile)->die != tile_extra_data(dst.tile)->die)
+        d2d += 2000 + 100 * d2d_detour(d2d_x0, sx, dx);
 
     return 100 + 100 * (std::abs(dx - sx) + std::abs(dy - sy)) + d2d;
 }
