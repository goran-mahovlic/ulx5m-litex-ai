diff --git a/himbaechel/uarch/gatemate/gatemate.cc b/himbaechel/uarch/gatemate/gatemate.cc
index 6c08e76f..eb0ad36f 100644
--- a/himbaechel/uarch/gatemate/gatemate.cc
+++ b/himbaechel/uarch/gatemate/gatemate.cc
@@ -199,6 +199,30 @@ void GateMateImpl::init(Context *ctx)
     }
     if (!die_name.empty() && !found)
         log_error("Unable to select forced die '%s'.\n", die_name.c_str());
+
+    // Die-to-die connections do not exist in every column (CCGM1A2: only from X29 up). Remember where they
+    // start, so the delay estimate and the routing box of a net that crosses a die boundary include the detour.
+    d2d_x0 = 0;
+    if (index > 1) {
+        d2d_x0 = ctx->getGridDimX();
+        for (auto wire : ctx->getWires()) {
+            if (ctx->getWireName(wire)[1].str(ctx).find("D2D") == std::string::npos)
+                continue;
+            // every SB has D2D wires, only those joined to the other die (a pip there drives them) count
+            int die = tile_extra_data(wire.tile)->die;
+            bool crosses = false;
+            for (auto pip : ctx->getPipsUphill(wire))
+                crosses |= tile_extra_data(pip.tile)->die != die;
+            for (auto pip : ctx->getPipsDownhill(wire))
+                crosses |= tile_extra_data(pip.tile)->die != die;
+            if (!crosses)
+                continue;
+            int x, y;
+            tile_xy(ctx->chip_info, wire.tile, x, y);
+            d2d_x0 = std::min(d2d_x0, x);
+        }
+        log_info("Die-to-die connections from X%d.\n", d2d_x0);
+    }
 }
 
 bool GateMateImpl::isBelLocationValid(BelId bel, bool explain_invalid) const
@@ -968,6 +992,9 @@ BoundingBox GateMateImpl::getRouteBoundingBox(WireId src, WireId dst) const
     int dx, dy;
     tile_xy(ctx->chip_info, dst.tile, dx, dy);
     expand(dx, dy);
+    // a net that changes die has to reach a column with die-to-die connections
+    if (tile_extra_data(src.tile)->die != tile_extra_data(dst.tile)->die)
+        expand(std::max(x0, d2d_x0), y0);
 
     return {(x0 & 0xfffe), (y0 & 0xfffe), (x1 & 0xfffe) + 1, (y1 & 0xfffe) + 1};
 }
