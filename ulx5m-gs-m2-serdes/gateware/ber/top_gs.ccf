# gs = ULX5M-GS na CM4 baseboardu. Konzola -> DirtyJTAG E660583883501E2C if01 (isti pinovi kao LiteX SBC buildovi,
# build/s_gtree_3_rep/intergalaktik_ulx5m_gs.ccf). IO_NA_A4/B4 iz starije lekcije NISU spojeni na sondu (izmjereno 26.09.).
NET "clk_i"   Loc = "IO_SB_A8" | SCHMITT_TRIGGER=true;
NET "uart_tx" Loc = "IO_NB_B5";
NET "uart_rx" Loc = "IO_NA_B6" | PULLUP=true;
