// CC_SERDES parameters, extracted from serdes_lb_dut.v (CologneChip serdes_lb.v, proven 26.09.2026).
// Analog/CDR fields come from A_* localparams in ber_top.v (PROFILE 0 = these old values, 1 = pu-cc ab7ce94 5G set).
.RX_BUF_RESET_TIME(5'h3),
    .RX_PCS_RESET_TIME(5'h3),
    .RX_RESET_TIMER_PRESC(A_TIMER_PRESC),
    .RX_RESET_DONE_GATE(1'h0),
